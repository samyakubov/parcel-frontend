{
  "name": "parcel-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "pnpm run lint && pnpm run type-check && pnpm run check-unused && depcheck",
    "analyze": "ANALYZE=true next build",
    "postinstall": "next telemetry disable",
    "check-unused": "ts-unused-exports tsconfig.json --excludePathsFromReport=\"test|spec|\\.next|proxy\\.ts|tailwind\\.config\\.mjs|app/(manifest|robots|sitemap).ts|app/(layout|not-found|page).tsx|src/components/ui|app/.*/page\\.tsx\""
  },
  "depcheck": {
    "ignores": [
      "@tailwindcss/postcss",
      "tailwindcss",
      "tw-animate-css",
      "eslint-config-next"
    ]
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "axios": "^1.11.0",
    "axios-cache-interceptor": "^1.11.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.542.0",
    "mapbox-gl": "^3.14.0",
    "mobx": "^6.13.7",
    "mobx-react": "^9.2.0",
    "next": "15.5.2",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/recharts": "^1.8.29",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-plugin-security": "^3.0.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.9.2"
  }
}
