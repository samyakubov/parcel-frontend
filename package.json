{
  "name": "parcel-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "validate": "pnpm lint && pnpm type-check && pnpm check-unused && depcheck",
    "analyze": "ANALYZE=true next build",
    "postinstall": "next telemetry disable",
    "check-unused": "ts-unused-exports tsconfig.json --excludePathsFromReport=\"test|spec|\\.next|proxy\\.ts|tailwind\\.config\\.mjs|app/(manifest|robots|sitemap).ts|app/(layout|not-found|page).tsx|src/components/ui|app/.*/page\\.tsx\""
  },
  "depcheck": {
    "ignores": [
      "@tailwindcss/postcss",
      "tailwindcss",
      "tw-animate-css",
      "eslint-config-next",
      "@types/node"
    ]
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.13.4",
    "axios-cache-interceptor": "^1.11.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.33.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lodash-es": "^4.17.23",
    "lucide-react": "^0.563.0",
    "mapbox-gl": "^3.18.1",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-toastify": "^11.0.5",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
